# Used by local development. Production browser requests use the same-origin
# Vercel /api proxy configured in vercel.json.
REACT_APP_BACKEND_URL=http://localhost:8001
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# PayPal Smart Buttons (client-side SDK). Sandbox vs live is determined by
# which client id you use (and by PAYPAL_ENV + secret on the backend).
# Get the client id from https://developer.paypal.com/dashboard/applications/sandbox
# (sandbox) or .../live (live). Required for Buy Credits — empty means no checkout.
REACT_APP_PAYPAL_ENV=sandbox
REACT_APP_PAYPAL_CLIENT_ID=
