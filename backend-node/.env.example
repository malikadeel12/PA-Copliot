PORT=8001
CORS_ORIGINS=""

SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

ADMIN_EMAIL="admin@example.com"

ANTHROPIC_API_KEY="sk-ant-REPLACE-WITH-YOUR-KEY"
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"
# Optional: use a cheaper supported model for OCR-text-to-JSON structuring.
# Falls back to ANTHROPIC_MODEL when omitted.
ANTHROPIC_EXTRACTION_MODEL=""

# Google Document AI (OCR). Either set GCP_SERVICE_ACCOUNT_JSON to the full service-account
# JSON string (recommended on Render/Vercel), OR set GCP_KEY_FILE to a local JSON key path.
GCP_SERVICE_ACCOUNT_JSON=""
GCP_KEY_FILE="./gcp-service-account.json"
DOCUMENT_AI_LOCATION="us"
# Enterprise / Document OCR (~$0.0015/page) — used for Patient ID + clinical notes.
# DOCUMENT_AI_PROCESSOR_ID is kept as a legacy alias for the OCR processor.
DOCUMENT_AI_OCR_PROCESSOR_ID="your-enterprise-ocr-processor-id"
DOCUMENT_AI_PROCESSOR_ID="your-enterprise-ocr-processor-id"
# Form Parser — insurance cards ONLY. Leave empty to OCR insurance with Enterprise OCR.
DOCUMENT_AI_FORM_PARSER_ID=""

# PayPal Orders v2 — credit pack purchases.
# Get client-id + secret from https://developer.paypal.com/dashboard/applications/sandbox
# (sandbox) or .../live (live). Switch PAYPAL_ENV between deployments.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
